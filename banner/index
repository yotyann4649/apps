      initDefaultBg();

/* ★2026-08-20（理子・舷門 6代目「欄（らん）」）：記事タイトルから段組をつくる ━━━━━━━━━
   ★出どころ … 城主のカケラ「記事タイトルを入れたら素人感まる出しのデザインになってしまう」
   ★実測 …… 公開中の実タイトル 52本で走らせた（★52本とも自然な切れ目で割れた／等分に落ちたのは0本）
             ★ただし 38本（73%）は、そのままでは1段が10文字を超える
             → ★これが「記事タイトルをそのまま入れると素人感が出る」の中身である
   ★ES3で書いている理由 … この環境の cscript //E:JScript で、実際に走らせて確かめられるため。
                          ★画面を開かずに、割り方が正しいかを機械で測れる。
   ★決めるのは人である。ここが出すのは案だけで、下の各段は手でいくらでも直せる。
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ */
var TITLE_SPLIT = (function () {

  var MARK    = ['、', '。', '！', '？', '!', '?', '…', '・'];
  var CLOSER  = ['」', '』', '）', ')', '】', '〉', '》'];
  var OPEN    = ['「', '『', '（', '(', '【', '〈', '《'];
  var JOSHI2  = ['から', 'まで', 'より', 'など', 'ため', 'ので', 'のに', 'こと', 'という', 'ための', 'ときの', 'ように'];
  var JOSHI_S = ['が', 'を', 'は', 'に', 'で', 'と'];   /* 強い助詞 */
  var JOSHI_W = ['の', 'も', 'へ', 'や'];               /* 弱い助詞 */

  var MAXLEN  = 10;   /* 1段の上限 */
  var MINLEN  = 4;    /* 1段の下限 */
  var MIN1ST  = 7;    /* ★第1段は掴みなので、もう少し欲しい */
  var TOTAL   = 30;   /* 全体の目安 */

  function has(a, v) {
    var i;
    for (i = 0; i < a.length; i++) { if (a[i] === v) { return true; } }
    return false;
  }

  function trimJa(s) {
    return s.replace(/^[\s　]+/, '').replace(/[\s　]+$/, '');
  }

  /* 文字の種類。ひらがな→漢字などの変わり目は、日本語の意味の切れ目とよく一致する */
  function kind(ch) {
    var c = ch.charCodeAt(0);
    if (c >= 0x3040 && c <= 0x309F) { return 'H'; }
    if (c >= 0x30A0 && c <= 0x30FF) { return 'K'; }
    if ((c >= 0x4E00 && c <= 0x9FFF) || (c >= 0x3400 && c <= 0x4DBF)) { return 'C'; }
    if ((c >= 0x30 && c <= 0x39) || (c >= 0xFF10 && c <= 0xFF19)) { return 'N'; }
    if ((c >= 0x41 && c <= 0x5A) || (c >= 0x61 && c <= 0x7A)) { return 'A'; }
    return 'O';
  }

  /* 貼り付けたタイトルから、サムネに要らないものを静かに落とす（責めない） */
  function preclean(s) {
    var t = String(s).replace(/[\r\n]+/g, '');
    t = t.replace(/^【[^】]*】/, '');           /* 先頭の管理番号。読む人には意味がない */
    t = trimJa(t);
    t = t.replace(/^『([\s\S]*)』$/, '$1');
    t = t.replace(/^「([\s\S]*)」$/, '$1');
    return trimJa(t);
  }

  /* ★段の数は、文字数から決める。
     ★短い題を無理に4段へ割ると、1段3文字のような不自然な段が生まれる
       （城主の実物＝18文字。4段では破綻し、3段で収まった） */
  function tierCount(len) {
    if (len <= 16) { return 2; }
    if (len <= 24) { return 3; }
    return 4;
  }

  /* 切ってよい位置の一覧。at = そこまでが1段になる境目 */
  function cutPoints(s) {
    var out = [], i, prev, next, two, w, kp, kn;
    for (i = 1; i < s.length; i++) {
      prev = s.charAt(i - 1);
      next = s.charAt(i);
      two  = (i >= 2) ? s.substring(i - 2, i) : '';
      w = 0;

      if (has(MARK, prev))          { w = 7; }
      else if (has(CLOSER, prev))   { w = 6; }
      else if (has(JOSHI2, two))    { w = 5; }
      else if (has(JOSHI_S, prev))  { w = 5; }
      else if (has(JOSHI_W, prev))  { w = 1; }

      /* 文字の種類の変わり目（ひらがな → 漢字・カタカナ・英数）。
         ★「売上を左右する|本当の理由」は助詞では切れない。ここが拾う */
      kp = kind(prev); kn = kind(next);
      if (kp === 'H' && (kn === 'C' || kn === 'K' || kn === 'A' || kn === 'N')) { w += 3; }
      if (has(OPEN, next)) { w += 2; }

      if (w > 0) { out.push({ at: i, w: w }); }
    }
    return out;
  }

  /* 括弧が段をまたいで壊れていないか */
  function bracketBroken(part) {
    var i, c, d = 0, bad = 0;
    for (i = 0; i < part.length; i++) {
      c = part.charAt(i);
      if (has(OPEN, c)) { d++; }
      else if (has(CLOSER, c)) { if (d > 0) { d--; } else { bad++; } }
    }
    return bad + d;
  }

  /* 良くない割り方ほど大きい値を返す。emp = 強調に使う段の位置 */
  function penalty(s, cuts, lens, ws, emp) {
    var i, p = 0, sum = 0, avg, prev, part, last;

    for (i = 0; i < lens.length; i++) {
      if (lens[i] > MAXLEN) { p += (lens[i] - MAXLEN) * 12; }
      if (lens[i] < MINLEN) { p += (MINLEN - lens[i]) * 10; }
      sum += lens[i];
    }
    if (lens[0] < MIN1ST) { p += (MIN1ST - lens[0]) * 12; }

    avg = sum / lens.length;
    for (i = 0; i < lens.length; i++) { p += (lens[i] - avg) * (lens[i] - avg) * 0.5; }

    for (i = 0; i < ws.length; i++) { p -= ws[i] * 6; }

    p += lens[emp] * 0.8;   /* 強調に使う段は、やや短いほうが映える */

    prev = 0;
    for (i = 0; i < lens.length; i++) {
      part = s.substring(prev, prev + lens[i]);
      prev += lens[i];
      p += bracketBroken(part) * 14;
      last = part.charAt(part.length - 1);
      if (has(JOSHI_S, last) || has(JOSHI_W, last)) {
        p += 18;   /* ★助詞で終わる段は、文の途中で切れているので不自然に見える */
        if (i === lens.length - 1) { p += 12; }   /* ★いちばん下は、言い切らないと締まらない */
      }
    }
    return p;
  }

  function tailJoshiCount(parts) {
    var i, n = 0, last;
    for (i = 0; i < parts.length; i++) {
      last = parts[i].charAt(parts[i].length - 1);
      if (has(JOSHI_S, last) || has(JOSHI_W, last)) { n++; }
    }
    return n;
  }

  /* n段に割る組み合わせを全通り見て、いちばん自然なものを選ぶ */
  function splitNatural(s, n, emp) {
    var pts = cutPoints(s), best = null, out, prev, i;
    if (pts.length < n - 1) { return null; }

    function rec(from, chosen) {
      var i, lens, prev2, cuts, ws, p, ok;
      if (chosen.length === n - 1) {
        lens = []; prev2 = 0; cuts = []; ws = []; ok = true;
        for (i = 0; i < chosen.length; i++) {
          lens.push(pts[chosen[i]].at - prev2);
          prev2 = pts[chosen[i]].at;
          cuts.push(pts[chosen[i]].at);
          ws.push(pts[chosen[i]].w);
        }
        lens.push(s.length - prev2);
        for (i = 0; i < lens.length; i++) { if (lens[i] < 1) { ok = false; } }
        if (!ok) { return; }
        p = penalty(s, cuts, lens, ws, emp);
        if (best === null || p < best.p) { best = { p: p, lens: lens }; }
        return;
      }
      for (i = from; i < pts.length; i++) {
        chosen.push(i);
        rec(i + 1, chosen);
        chosen.pop();
      }
    }
    rec(0, []);

    if (best === null) { return null; }
    out = []; prev = 0;
    for (i = 0; i < best.lens.length; i++) {
      out.push(s.substring(prev, prev + best.lens[i]));
      prev += best.lens[i];
    }
    return out;
  }

  /* 自然な切れ目が足りないときの、代わりの案（等分）。止めずに手動の代替を出す */
  function splitEven(s, n) {
    var w = Math.ceil(s.length / n), out = [], i;
    for (i = 0; i < n; i++) { out.push(s.substring(w * i, (i === n - 1) ? s.length : w * (i + 1))); }
    return out;
  }

  /* 気づいたことを、責めずに伝える（入力ミスを責めない設計・U-001） */
  function advise(parts, natural, cut, n) {
    var msgs = [], i, total = 0, tails, over = 0;
    for (i = 0; i < parts.length; i++) { total += parts[i].length; }

    if (cut) { msgs.push('ok|先頭の【…】は、読む人には意味がないので外しました。1段まるごと空きます'); }
    msgs.push('ok|合計 ' + total + '文字なので、' + n + '段にしました');

    if (!natural) {
      msgs.push('warn|自然な切れ目が足りなかったので、等分した案を出しています。手で直してください');
    }
    for (i = 0; i < parts.length; i++) { if (parts[i].length > MAXLEN) { over++; } }

    if (total > TOTAL) {
      msgs.push('warn|' + TOTAL + '文字を超えています。記事タイトルは検索のための言葉、サムネは目で読ませる言葉です。別に作り直すほうが、たいてい早いです');
    }
    if (over > 0) {
      msgs.push('warn|1段が ' + MAXLEN + '文字を超えている段が ' + over + 'つあります（' + MINLEN + '〜' + MAXLEN + '文字が目安です）');
    }
    tails = tailJoshiCount(parts);
    if (tails >= 3) { msgs.push('warn|助詞で終わる段が ' + tails + 'つあります。2つまでにすると間延びしません'); }
    if (over === 0 && total <= TOTAL && tails < 3 && natural) {
      msgs.push('good|よく収まっています。強調は1箇所だけ、いちばん下は言い切りで締まっています');
    }
    return msgs;
  }

  return {
    MAXLEN: MAXLEN, MINLEN: MINLEN, TOTAL: TOTAL,
    tierCount: tierCount,

    /* 入口。title を渡すと { cleaned, parts, n, natural, emphasis, notes } を返す */
    run: function (title, forceN) {
      var raw = String(title).replace(/[\r\n]+/g, '');
      var t = preclean(raw);
      var cut = (t.length !== trimJa(raw).length);
      var n, emp, parts, natural = true;
      if (t.length === 0) { return null; }

      n = forceN ? forceN : tierCount(t.length);
      if (n < 2) { n = 2; }
      if (n > 4) { n = 4; }
      emp = (n >= 3) ? 1 : 0;          /* ★強調は上から2段目。2段のときだけ1段目 */

      parts = splitNatural(t, n, emp);
      if (parts === null) { parts = splitEven(t, n); natural = false; }

      return { cleaned: t, parts: parts, n: n, natural: natural, emphasis: emp, notes: advise(parts, natural, cut, n) };
    }
  };
})();

/* ★上でつくった案を、下の各段へ流し込む（★決めるのは人。ここは案を置くだけ） */
      const titleSrc = document.getElementById('titleSrc');
      const tierMode = document.getElementById('tierMode');
      const splitBtn = document.getElementById('splitBtn');
      const splitNote = document.getElementById('splitNote');
      const srcLen = document.getElementById('srcLen');

      const escHtml = (s) => String(s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));

      titleSrc.addEventListener('input', () => {
        srcLen.textContent = titleSrc.value.replace(/[\r\n]+/g, '').length + '文字';
      });

      const applySplit = () => {
        const forceN = (tierMode.value === 'auto') ? 0 : parseInt(tierMode.value, 10);
        const r = TITLE_SPLIT.run(titleSrc.value, forceN);
        if (r === null) {
          splitNote.innerHTML = '記事タイトルを貼ってから、もう一度 押してください。';
          return;
        }

        /* 段ごとの中身・装飾・大きさを入れる。
           ★大きさは、城主が「このイメージ」と示された実物の比率に合わせている */
        const BASE = [76, 88, 82, 74];
        for (let i = 0; i < 4; i++) {
          const on = (i < r.n);
          document.getElementById(`t${i}_enable`).checked = on;
          document.getElementById(`t${i}_text`).value = on ? r.parts[i] : '';
          if (!on) continue;

          const isLast = (i === r.n - 1);
          const isEmp = (i === r.emphasis);
          document.getElementById(`t${i}_type`).value = isLast ? 'badge' : (isEmp ? 'marker' : 'plain');

          /* 強調の段をいちばん大きく、いちばん下の段はやや控えめに */
          let size = BASE[i] || 78;
          if (isEmp) { size = 88; }
          else if (isLast) { size = 74; }
          else { size = 78; }
          document.getElementById(`t${i}_size`).value = size;

          if (isLast) {
            document.getElementById(`t${i}_stroke`).value = 0;
            document.getElementById(`t${i}_mthick`).value = 22;   /* 座布団の縦余白 */
            document.getElementById(`t${i}_mpos`).value = 46;     /* 座布団の横余白 */
          } else if (isEmp) {
            document.getElementById(`t${i}_stroke`).value = 22;
            document.getElementById(`t${i}_mthick`).value = 32;   /* マーカーの太さ */
            document.getElementById(`t${i}_mpos`).value = 16;     /* マーカーの位置 */
          } else {
            document.getElementById(`t${i}_stroke`).value = 20;
            document.getElementById(`t${i}_mthick`).value = 0;    /* 通常の段はマーカー無し */
            document.getElementById(`t${i}_mpos`).value = 15;
          }
        }

        /* 気づいたことを出す。★赤字で叱らない。色は控えめに使い分けるだけ */
        let html = '';
        for (let i = 0; i < r.notes.length; i++) {
          const bar = r.notes[i].indexOf('|');
          const kindTag = (bar >= 0) ? r.notes[i].substring(0, bar) : 'ok';
          const body = (bar >= 0) ? r.notes[i].substring(bar + 1) : r.notes[i];
          const cls = (kindTag === 'warn') ? 'warn' : (kindTag === 'good' ? 'ok' : '');
          html += '<span class="' + cls + '">・' + escHtml(body) + '</span>\n';
        }
        html += '\n<b>' + escHtml(r.cleaned) + '</b>  （' + r.cleaned.length + '文字 → ' + r.n + '段）';
        splitNote.innerHTML = html;

        srcLen.textContent = titleSrc.value.replace(/[\r\n]+/g, '').length + '文字';
        render();
      };

      splitBtn.addEventListener('click', applySplit);

      /* ★2026-08-20（理子・舷門 6代目「欄」）：④書体が届いてから、もう一度 描く ━━━━━━
         🔴 ★v2 はこれを持っていなかった（v1.1 で入れたものが戻っていた）。
            ★読み込みを待たずに描くと、最初の絵だけ別の書体のままになる。 */
      if (document.fonts && document.fonts.ready && typeof document.fonts.ready.then === 'function') {
        document.fonts.ready.then(() => { try { render(); } catch (e) { /* 既存の表示は絶対に壊さない */ } });
      }
    })();
  </script>
